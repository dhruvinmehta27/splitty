# Copy to .env.local (never committed) and fill in.

# Server only: your SQLite Cloud connection string, including its API key.
# On Vercel, add it under Project → Settings → Environment Variables instead.
SQLITECLOUD_URL=sqlitecloud://<host>:8860/<database>?apikey=<key>

# App: where the sync server lives. Leave unset for a device-only app with no sharing.
# Local testing: http://localhost:3001   Vercel: https://<your-project>.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3001
